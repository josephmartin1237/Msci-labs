import numpy as np
import scipy 
 

def sector_states(L, n_up):
        
    all_states = np.arange(2**L)
    number_of_ones = np.zeros(2**L, dtype = int)
    for i in range(L):
        number_of_ones += (all_states >> i) & 1 
        
        
    return all_states[number_of_ones == n_up]
    

