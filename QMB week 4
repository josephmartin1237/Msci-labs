def heisenberg_sector(L, n_up):
    states = sector_states(L, n_up)
    D = len(states)
    diagonal = np.zeros(D)
    rows, cols = [],[]
    for i in range(L):
        j = (i+1) % L 
        bit_i = (states >> i) & 1
        bit_j = (states >> j) & 1
        parralel = bit_i == bit_j
        diagonal += np.where(parralel, 0.25, -0.25)
        #anti = 
    
    
    
    return diagonal
    
